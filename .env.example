# Copy to .env.local and fill in what you need. Every variable is optional —
# with none set the app runs in rules-only mode with fallback prices.

# --- AI provider (optional; enables "AI-enhanced" mode) --------------------
# Google Gemini. Either name works; GOOGLE_API_KEY wins if both are set.
GOOGLE_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# Model id. The default "gemini-3.8-flash" has NOT been verified in the audit —
# set this to a model your key can access.
# GOOGLE_MODEL=

# OpenRouter (tried after Google, one model at a time).
OPENROUTER_API_KEY=
# Comma-separated model ids; defaults are the free models listed in llmClient.ts.
# OPENROUTER_MODELS=

# --- GitHub (optional) ------------------------------------------------------
# Raises the GitHub REST limit from 60 to 5,000 requests/hour. Read-only,
# public-repo scope is enough. Never commit a real token.
GITHUB_TOKEN=

# --- Pricing (optional) -----------------------------------------------------
# "bulk" (default): public AWS Price List files, no credentials.
# "sdk": @aws-sdk/client-pricing; needs credentials with pricing:GetProducts only.
PRICE_SOURCE=bulk
# AWS_PRICING_REGION=us-east-1
